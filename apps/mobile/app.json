{
  "expo": {
    "name": "ClickIn",
    "slug": "clickin-attendance",
    "scheme": "attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "ClickIn Student Attendance",
      "shortName": "ClickIn",
      "backgroundColor": "#f8fafc",
      "themeColor": "#1D70F7",
      "display": "standalone",
      "orientation": "portrait",
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.clickin.attendance",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is used only to capture live attendance photos during check-in and check-out.",
        "NSLocationWhenInUseUsageDescription": "Location access is used only to verify eligibility for school event attendance.",
        "NSPhotoLibraryUsageDescription": "Photo library access is not used for attendance evidence."
      }
    },
    "android": {
      "package": "com.clickin.attendance",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#021B79"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Location is requested only during attendance eligibility checks.",
          "motionUsagePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is required for live attendance photos and QR scanning.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0f766e"
        }
      ],
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
